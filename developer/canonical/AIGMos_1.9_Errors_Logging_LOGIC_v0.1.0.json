  "constraints": {
    "invariants": [
      {
        "id": "LOGIC-I01",
        "rule": "Every node is an explicit code NodeType #LOGIC identity, never inferred from a filename."
      },
      {
        "id": "LOGIC-I02",
        "rule": "ERROR is a shared library that does not import HC.CS or AC; BOOT/CS depend on ERROR, not inverse."
      },
      {
        "id": "LOGIC-I03",
        "rule": "ERROR always hard-fails its originating operation; successful return value literal ERROR remains status OK."
      },
      {
        "id": "LOGIC-I04",
        "rule": "A failed CS invocation causes exactly one command+parameter trace in Logging even mode off; no fabricated CS record for non-CS BOOT Error."
      },
      {
        "id": "LOGIC-I05",
        "rule": "Error owns Error Buffer; Logging owns Log Buffer. Both capacities are configured independently (N>0 last N; N=0 all)."
      },
      {
        "id": "LOGIC-I06",
        "rule": "Function input_refs/output_refs resolve only to Properties owned by the same code Entity."
      },
      {
        "id": "LOGIC-I07",
        "rule": "Source import dependency is NOT inferred from generic failed_cs_trace_sink relation, because direct ERROR->LOGGING source import remains undecided."
      },
      {
        "id": "LOGIC-I08",
        "rule": "Function.logic body is not invented without concrete normative logic and an applicable CW primitive; gaps are explicit and status remains unlocked."
      },
      {
        "id": "LOGIC-I09",
        "rule": "No sixth mandatory Hardcore component or standalone Audit subsystem is introduced."
      }
    ]
  },
