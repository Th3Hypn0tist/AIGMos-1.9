  "entities": [
    {
      "id": "#CTRCT:AIGMOS19:ERROR",
      "name": "Unified Error Contract",
      "entity_type_ref": "contract",
      "status": "unlocked",
      "members": [
        "#LOGIC:AIGMOS19:ERROR"
      ],
      "properties": [
        {
          "id": "CONTRACT_RULES",
          "property_type_ref": "data",
          "ruleset_ref": "RULESET_DATA",
          "status": "unlocked",
          "value": {
            "data_type_ref": "A19.CONTRACT_REQUIREMENT_SET",
            "value": {
              "requirements": [
                {
                  "id": "ERROR-01",
                  "rule": "Every actual ERROR is a hard failure of its originating execution; no soft, warning or recoverable ERROR.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "ERROR-02",
                  "rule": "One shared Error System Lib serves BOOT, Hardcore, Core, System and User Modules, without HC.CS or AC runtime import dependency.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "ERROR-03",
                  "rule": "Error System Lib owns Error Buffer; successful data equal to the literal ERROR is not an Error event.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "ERROR-04",
                  "rule": "Canonical Error during actual CS invocation causes one corresponding CS+parameters trace; non-CS errors never fabricate CS input.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "ERROR-05",
                  "rule": "An ERROR carries available AC actor identity whenever AC is runtime-active, independently of Logging mode.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "ERROR-06",
                  "rule": "Failure propagates out of the originating operation; whole-instance shutdown is not implied without the owning lifecycle contract.",
                  "authority": "user_confirmed_semantics"
                }
              ]
            },
            "properties": {}
          },
          "metadata": {
            "authority": "user_confirmed_decisions",
            "source": "2026-11-23..2026-11-27 AIGMos 1.9 development session"
          }
        },
        {
          "id": "CONTRACT_SCOPE",
          "property_type_ref": "data",
          "ruleset_ref": "RULESET_DATA",
          "status": "unlocked",
          "value": {
            "data_type_ref": "A19.DECLARED_NORMATIVE_SCOPE",
            "value": {
              "declared_member_ref": "#LOGIC:AIGMOS19:ERROR",
              "scope_rule": "Contract.members declares the explicit normative scope; later implementation file affiliation is a distinct relation."
            },
            "properties": {}
          }
        }
      ]
    },
    {
      "id": "#CTRCT:AIGMOS19:LOGGING",
      "name": "Logging & Buffer Contract",
      "entity_type_ref": "contract",
      "status": "unlocked",
      "members": [
        "#LOGIC:AIGMOS19:LOGGING"
      ],
      "properties": [
        {
          "id": "CONTRACT_RULES",
          "property_type_ref": "data",
          "ruleset_ref": "RULESET_DATA",
          "status": "unlocked",
          "value": {
            "data_type_ref": "A19.CONTRACT_REQUIREMENT_SET",
            "value": {
              "requirements": [
                {
                  "id": "LOG-01",
                  "rule": "Logging owns Log Buffer; Error owns its separate Error Buffer. The owner identities are not #SYSTEM.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "LOG-02",
                  "rule": "Normal CS logging modes are off (default), cs and ac. off suppresses routine successful CS logging, not mandatory failure traces.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "LOG-03",
                  "rule": "A failed CS invocation contributes exactly one command+parameter log entry whether off, cs or ac; never duplicate one invocation.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "LOG-04",
                  "rule": "Mode cs requires HC.CS capability; mode ac requires HC.CS plus AccessCore; these capability requirements do not imply Python import direction.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "LOG-05",
                  "rule": "Both Buffer lengths come from protected config.json; positive N retains newest N, zero retains all; limits independent.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "LOG-06",
                  "rule": "No separate bot-training Audit subsystem is included as a mandatory AIGMos 1.9 component.",
                  "authority": "user_confirmed_semantics"
                }
              ]
            },
            "properties": {}
          },
          "metadata": {
            "authority": "user_confirmed_decisions",
            "source": "2026-11-23..2026-11-27 AIGMos 1.9 development session"
          }
        },
