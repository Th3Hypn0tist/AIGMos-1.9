    {
      "id": "#CTRCT:AIGMOS19:CSO",
      "name": "CS / CSo Outcome Contract",
      "entity_type_ref": "contract",
      "status": "unlocked",
      "members": [
        "#LOGIC:AIGMOS19:HC.CS"
