      "properties": [
        {
          "id": "CONTRACT_RULES",
          "property_type_ref": "data",
          "ruleset_ref": "RULESET_DATA",
          "status": "unlocked",
          "value": {
            "data_type_ref": "A19.CONTRACT_REQUIREMENT_SET",
            "value": {
              "requirements": [
                {
                  "id": "CSO-01",
                  "rule": "CS is input; internal result tag status is OK or ERROR and is authoritative, not inferred from returned content.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "CSO-02",
                  "rule": "When OK and payload absent, CSo returns plain OK; when OK with payload, CSo returns original command feedback unwrapped.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "CSO-03",
                  "rule": "Payload presence is separate from value; literal ERROR, literal OK, null, false, zero and empty string may be successful returned data.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "CSO-04",
                  "rule": "Internal status ERROR always hard-fails the current CS execution and is represented through shared Error System Lib.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "CSO-05",
                  "rule": "If actual CS execution fails, the Error Buffer records the failure and the Log Buffer records one invocation trace.",
                  "authority": "user_confirmed_semantics"
                },
                {
                  "id": "CSO-06",
                  "rule": "The external transport representation must preserve the internal status, even when the text output alone is ambiguous.",
                  "authority": "user_confirmed_semantics"
                }
              ]
            },
            "properties": {}
          },
          "metadata": {
            "authority": "user_confirmed_decisions",
            "source": "2026-11-23..2026-11-27 AIGMos 1.9 development session"
          }
