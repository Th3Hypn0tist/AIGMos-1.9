  "constraints": {
    "invariants": [
      {
        "id": "I01",
        "rule": "One shared Error semantics across BOOT and all modules; no sixth mandatory Hardcore mechanism."
      },
      {
        "id": "I02",
        "rule": "Successful CSo is plain OK or command result, without compulsory wrapper; failure uses unified ERROR."
      },
      {
        "id": "I03",
        "rule": "Every failed CS execution creates one log entry containing command and parameters, even in logging mode off."
      },
      {
        "id": "I04",
        "rule": "Normal Logging modes off/cs/ac have default off; Logging cannot silence Errors or error-triggered CS records."
      },
      {
        "id": "I05",
        "rule": "Available AC actor identity is included in every Error whenever AC is active, independent of logging mode."
      },
      {
        "id": "I06",
        "rule": "Each Buffer has its own config.json count N; N>=1 retains last N, N=0 retains all entries."
      },
      {
        "id": "I07",
        "rule": "Selected logging mode cs depends on CS; ac depends on CS+AccessCore; off avoids continuous logging dependencies."
      },
      {
        "id": "I08",
        "rule": "No standalone Audit/bot-training subsystem is included in AIGMos 1.9."
      },
      {
        "id": "I09",
        "rule": "INTERNAL CS outcome status OK or ERROR is authoritative; CSo raw command result, including the literal ERROR or OK, cannot change execution status."
      },
      {
        "id": "I10",
        "rule": "The presence of a successful command return is represented separately from its value. When absent CSo emits plain OK; when present, CSo emits raw data, including null, false, zero or empty string."
      },
      {
        "id": "I11",
        "rule": "Every actual ERROR is a hard fail of its originating execution, not a warning, recoverable/soft failure or successful result. Neither handler nor logger may silently downgrade it to OK."
      },
      {
        "id": "I12",
        "rule": "On CS internal status ERROR, stop the current command execution and propagate failure with the common Error record. Do not infer whole-instance shutdown from an individual operation's hard fail absent owner-specific lifecycle rules."
      },
      {
        "id": "I13",
        "rule": "Legacy 'recoverable' when present on a canonical ERROR record must never be true. The Error library's severity, message and context fields do not weaken ERROR hard-fail semantics."
      }
    ]
  },
